<?xml version="1.0" encoding="utf-8"?>
<!-- Truecaller-style M-PESA SMS notification body (DecoratedCustomViewStyle).
     The SYSTEM draws the header row above this ("Truecaller · SMS from MPESA · now" + the
     blue-circle small icon + time + expander). This custom view supplies only the body,
     left-aligned under the header text:

         [M-PESA logo]   UH… received Ksh… from … 0713***703.
                         ✨ AI summary
         Mark as read

     LOGO SPEC (measured pixel-for-pixel from the reference screenshot on a 411dp-wide device,
     screenshot scale ≈ 1.365 px/dp, calibrated from the 379dp notification content width):
       • Circular white-background M-PESA logo (@mipmap/av_mpesa_circle) = 33dp.
       • Logo sits at the content-left edge (marginStart 0), top-aligned with the first text line
         (gravity=top → logo top matches the summary's first line to within ~1px).
       • Message text column starts 17dp to the right of the logo.
       • "Mark as read" is left-aligned at the content-left edge (same x as the logo), NOT indented.
     Text colours stay theme-aware (?android:attr/textColor*) so the notification reads correctly
     on both light and dark shades. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Body row: circular white-bg M-PESA logo + (AI summary line + "AI summary" label). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <ImageView
            android:id="@+id/ntf_logo"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@mipmap/av_mpesa_circle"
            android:contentDescription="M-PESA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="17dp">

            <TextView
                android:id="@+id/ntf_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:text="AI summary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action: "Mark as read" — left-aligned at the content-left edge (under the logo). -->
    <TextView
        android:id="@+id/ntf_mark_read"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#146FF5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Mark as read" />
</LinearLayout>
