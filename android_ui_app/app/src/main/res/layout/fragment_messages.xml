<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/m_bg">

    <LinearLayout android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_msg_search" android:layout_margin="12dp"
        android:paddingStart="6dp" android:paddingEnd="10dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
            <View android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_contacts_circle"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_tcx_contacts_24dp" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="top|end" android:gravity="center" android:text="2" android:textSize="10sp" android:textColor="@color/m_brand_blue" android:fontFamily="@font/roboto_medium" android:background="@drawable/bg_white_badge"/>
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Search numbers, names &amp; more" android:textColor="@color/m_text_secondary" android:textSize="15sp" android:layout_marginStart="12dp"/>
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_tcx_more_vert_24dp" app:tint="@color/m_text_secondary"/>
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:layout_marginTop="2dp" android:background="@drawable/bg_red_badge"/>
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/chipScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/searchBar" android:scrollbars="none" android:paddingStart="12dp" android:paddingBottom="6dp">
        <LinearLayout android:id="@+id/chipContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/chipScroll" android:clipToPadding="false" android:paddingBottom="8dp"/>

    <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_margin="16dp" android:background="@drawable/bg_compose_fab">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_tcx_new_message_variant_24dp" app:tint="#FFFFFFFF"/>
    </FrameLayout>
</RelativeLayout>