<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/m_bg">

    <!-- Toolbar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
            android:src="@drawable/arrow_back" app:tint="@color/m_text_primary" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp"
            android:src="@drawable/av_mpesa" android:scaleType="fitCenter"/>
        <TextView android:id="@+id/toolbarTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MPESA" android:textColor="@color/m_text_primary" android:textSize="20sp" android:fontFamily="@font/roboto_medium" android:layout_marginStart="12dp"/>
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_tcx_more_vert_24dp" app:tint="@color/m_text_primary" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Thread -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/thread" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp"/>
    </ScrollView>

    <!-- Footer: Report / View profile + replying not supported -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_report_btn" android:paddingHorizontal="22dp" android:layout_marginEnd="10dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_secure_smart_sms_icon" app:tint="@color/m_report_red" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report" android:textColor="@color/m_report_red" android:textSize="15sp" android:fontFamily="@font/roboto_medium"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_viewprofile_btn" android:paddingHorizontal="22dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_info_circle" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View profile" android:textColor="@color/m_link_blue" android:textSize="15sp" android:fontFamily="@font/roboto_medium"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Replying is not supported by this sender" android:textColor="@color/m_text_tertiary" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
    </LinearLayout>
</LinearLayout>
