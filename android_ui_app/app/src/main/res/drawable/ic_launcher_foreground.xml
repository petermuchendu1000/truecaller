<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground = the COMPLETE icon, kept inside the adaptive safe zone (central ~72dp
     of the 108dp canvas) so the notification/launcher circular mask never crops the blue ring or the
     tail. Blue circle + circular black bubble + lower-left sharp tail + 3 blue dots. The <background>
     is the same blue, so if a mask shows beyond the drawn circle it stays seamless blue. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- blue circle (outer) -->
    <path android:fillColor="#FF4A8EF5" android:pathData="M54,54 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0"/>
    <!-- tail (drawn before bubble so the bubble overlaps its base) -->
    <path android:fillColor="#FF000000" android:pathData="M51.7,77.9 L36.5,82 L31.5,65 Z"/>
    <!-- circular black bubble (leaves a blue margin to the outer circle) -->
    <path android:fillColor="#FF000000" android:pathData="M54,52 m-26,0 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0"/>
    <!-- three blue dots, centred -->
    <path android:fillColor="#FF4A8EF5" android:pathData="M44,52 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M54,52 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M64,52 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>
</vector>
