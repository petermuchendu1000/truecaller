<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="18dp" android:paddingVertical="14dp"
    android:background="?android:attr/selectableItemBackground">
    <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_circle_orange">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center"
            android:src="@drawable/ic_premium_crown" app:tint="#FFFFFFFF"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Get Truecaller Premium" android:textColor="@color/textPrimary" android:textSize="17sp" android:fontFamily="@font/roboto_medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Remove ads, see who viewed your profile &amp; more" android:textColor="@color/textSecondary" android:textSize="14sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>