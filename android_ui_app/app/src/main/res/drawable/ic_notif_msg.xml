<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: three horizontal dots, centred in the icon canvas. The SYSTEM draws
     the accent circle badge (setColor = Truecaller blue) around the tinted glyph, so the rendered
     header icon is a blue circle with three dots at its centre — matching the reference screenshot.

     Measured from the reference (37px badge): the three dots sit on the vertical centre line, evenly
     spaced (~4.5px apart, ~2px diameter) and horizontally centred. Mapped into the 24x24 viewport
     that is: y = 12 (centre), x = 8 / 12 / 16, radius ~1.0. The previous design added a filled
     message-bubble outline + tail with the dots high (y=9); that bubble is removed so only the three
     centred dots remain inside the system circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,12 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 M12,12 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 M16,12 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0"/>
</vector>
