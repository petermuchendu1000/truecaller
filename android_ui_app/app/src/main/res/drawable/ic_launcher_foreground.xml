    <path android:fillColor="#FF000000" android:pathData="M54,51.3 m-38.9,0 a38.9,38.9 0 1,0 77.8,0 a38.9,38.9 0 1,0 -77.8,0"/>
    <!-- three blue dots, centred -->
    <path android:fillColor="#FF4A8EF5" android:pathData="M38.9,51.3 m-4.4,0 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0 M54,51.3 m-4.4,0 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0 M69.1,51.3 m-4.4,0 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"/>
