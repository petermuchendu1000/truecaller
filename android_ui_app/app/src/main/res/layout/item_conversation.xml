<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors com.truecaller layout_tcx_list_item: 52dp avatar, 72dp row, title/subtitle/timestamp -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:background="?android:attr/selectableItemBackground"
    android:paddingHorizontal="12dp">

    <FrameLayout android:id="@+id/avatarWrap"
        android:layout_width="52dp" android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/avatar" android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_circle_avatar" android:gravity="center"
            android:textColor="@color/avatarTextBlue" android:textSize="20sp"
            android:fontFamily="@font/roboto_medium" />
        <View android:id="@+id/avail" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_gravity="bottom|end" android:background="@drawable/bg_avail_dot" android:visibility="gone" />
    </FrameLayout>

    <TextView android:id="@+id/title"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
        android:textSize="15sp" android:textColor="@color/textPrimary" android:fontFamily="@font/roboto_medium"
        app:layout_constraintStart_toEndOf="@id/avatarWrap" app:layout_constraintEnd_toStartOf="@id/right"
        app:layout_constraintTop_toTopOf="@id/avatarWrap" app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView android:id="@+id/subtitle"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
        android:layout_marginTop="3dp" android:textSize="13sp" android:textColor="@color/textSecondary"
        app:layout_constraintStart_toEndOf="@id/avatarWrap" app:layout_constraintEnd_toStartOf="@id/right"
        app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintBottom_toBottomOf="@id/avatarWrap" />

    <LinearLayout android:id="@+id/right"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/timestamp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/textSecondary" />
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="20dp"
            android:minWidth="20dp" android:gravity="center" android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge" android:paddingHorizontal="6dp"
            android:textColor="@color/onBrand" android:textSize="11sp" android:fontFamily="@font/roboto_medium"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
