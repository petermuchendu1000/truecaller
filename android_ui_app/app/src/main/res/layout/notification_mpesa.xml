<?xml version="1.0" encoding="utf-8"?>
<!-- Truecaller-style M-PESA SMS notification body (DecoratedCustomViewStyle), laid out to match the
     reference pixel-for-pixel. All measurements below were taken from the reference screenshot on a
     411dp-wide device (screenshot scale ~= 1.365 px/dp, calibrated from the 379dp notification
     content width). The system still draws the header text row ("Truecaller · SMS from MPESA · now")
     and the expander; this custom view supplies the icons + body so the icons land exactly where the
     reference shows them.

     Layout (content-left edge = x0):
       Row 1 (header):  [Truecaller icon 26dp]  "Truecaller · SMS from MPESA · now"   [expander ^]
       Row 2 (body):    [M-PESA logo 33dp]      UH… received Ksh… from … 0713***703.
                                                ✦ AI summary
                        Mark as read

     Measured spec:
       • Truecaller message icon (@mipmap/ic_notif_circle) = 26dp, at content-left (marginStart 0),
         top-aligned with the header text (gravity=top). Header text starts 12dp right of the icon.
       • M-PESA logo (@mipmap/av_mpesa_circle) = 33dp, at content-left (marginStart 0), top-aligned
         with the first summary line (gravity=top). Message text column starts 17dp right of the logo.
       • AI-summary sparkle (@drawable/ic_sparkle_gold) = 12dp, at the text-column left edge, 6dp gap
         to the "AI summary" label.
       • "Mark as read" is left-aligned at the content-left edge (marginStart 0), NOT indented.
     Text colours stay theme-aware (?android:attr/textColor*) for light/dark shades. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header row: Truecaller message icon (top-left) + "Truecaller · SMS from MPESA · now".
         The expander chevron at the far right is system chrome (DecoratedCustomViewStyle).
         Measured: icon at content-left edge (marginStart 0), 26dp, top-aligned with header text;
         header text starts 15dp right of the icon. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <ImageView
            android:id="@+id/ntf_msg_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="0dp"
            android:src="@mipmap/ic_notif_circle"
            android:contentDescription="Truecaller" />

        <TextView
            android:id="@+id/ntf_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:text="Truecaller · SMS from MPESA · now" />
    </LinearLayout>

    <!-- Body row: circular white-bg M-PESA logo + (AI summary line + "AI summary" label). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/ntf_logo"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@mipmap/av_mpesa_circle"
            android:contentDescription="M-PESA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="17dp">

            <TextView
                android:id="@+id/ntf_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="" />

            <!-- AI-summary row: gold sparkle glyph + "AI summary" label. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_sparkle_gold"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:text="AI summary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Action: "Mark as read" — left-aligned at the content-left edge (under the icons). -->
    <TextView
        android:id="@+id/ntf_mark_read"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#146FF5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Mark as read" />
</LinearLayout>
