<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="16dp" android:paddingTop="10dp">

    <!-- Bubble -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/bg_sms_bubble" android:padding="14dp"
        android:layout_gravity="start" android:minWidth="320dp">

        <!-- Collapsible header row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/headerText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/m_text_primary"
                android:text="UH4MX1GGNE Confirmed. ..."/>
            <ImageView android:id="@+id/chevron" android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_tcx_action_call_24dp" app:tint="@color/m_text_secondary"
                android:rotation="90" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Expanded full body (gone by default) -->
        <TextView android:id="@+id/fullBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:textSize="16sp" android:textColor="@color/m_text_primary"
            android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:autoLink="web" android:textColorLink="@color/m_link_blue"/>

        <!-- Inner smart card -->
        <LinearLayout android:id="@+id/smartCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_smart_card" android:padding="14dp" android:layout_marginTop="12dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/catGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_alignParentStart="true">
                    <ImageView android:id="@+id/catIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_tcx_card_insights" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/catText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transaction" android:textColor="@color/m_text_secondary" android:textSize="12sp" android:fontFamily="@font/roboto_medium" android:letterSpacing="0.05"/>
                </LinearLayout>
                <TextView android:id="@+id/statusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:visibility="gone" android:text="Due" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="@font/roboto_medium" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:background="@drawable/bg_due_badge"/>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <TextView android:id="@+id/cardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@id/cardAmount" android:maxLines="1" android:ellipsize="end" android:text="Peter M..." android:textColor="@color/m_text_primary" android:textSize="18sp" android:fontFamily="@font/roboto_medium"/>
                <TextView android:id="@+id/cardAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="+ KSH 50" android:textColor="@color/m_amount_green" android:textSize="18sp" android:fontFamily="@font/roboto_medium"/>
            </RelativeLayout>
            <TextView android:id="@+id/cardSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Account x..." android:textColor="@color/m_text_secondary" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- SMS meta line -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_marginStart="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMS" android:textColor="@color/m_text_tertiary" android:textSize="12sp"/>
        <TextView android:id="@+id/smsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/m_text_primary" android:textSize="11sp" android:fontFamily="@font/roboto_medium" android:paddingHorizontal="5dp" android:paddingVertical="1dp" android:background="@drawable/bg_sms_count" android:layout_marginStart="6dp"/>
        <TextView android:id="@+id/smsTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="· 00:06" android:textColor="@color/m_text_tertiary" android:textSize="12sp" android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
