<?xml version="1.0" encoding="utf-8"?>
<!-- Dark input field for the sign-in screen: dark fill with a subtle border so white text is
     clearly visible (the reusable search-bar background is near-white and hides white text). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF1B2027" />
    <stroke android:width="1dp" android:color="#FF2E353F" />
    <corners android:radius="12dp" />
</shape>
