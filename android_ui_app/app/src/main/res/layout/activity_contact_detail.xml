<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bgPrimary" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <!-- ===== gradient header ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_detail_header" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingTop="8dp">
            <ImageView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/arrow_back" app:tint="#FFFFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/ic_heart_outline" app:tint="#FFFFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless"/>
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/ic_tcx_more_vert_24dp" app:tint="#FFFFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <FrameLayout android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp">
            <View android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center" android:background="@drawable/bg_avatar_detail"/>
            <TextView android:id="@+id/detailInitial" android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center"
                android:gravity="center" android:text="M" android:textColor="#FF1E5B3A" android:textSize="44sp" android:fontFamily="@font/roboto_medium"/>
            <TextView android:id="@+id/detailTBadge" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="top|center_horizontal"
                android:gravity="center" android:text="t" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="@font/roboto_medium" android:background="@drawable/bg_t_badge"/>
        </FrameLayout>

        <TextView android:id="@+id/detailName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="Mohan John" android:textColor="#FFFFFFFF" android:textSize="28sp" android:fontFamily="@font/roboto_medium" android:layout_marginTop="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginTop="18dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="In your contacts" android:textColor="#CCE3EEFF" android:textSize="13sp" android:layout_marginTop="10dp"/>
    </LinearLayout>

    <!-- ===== action bar ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@color/bgPrimary" android:paddingVertical="16dp" android:paddingHorizontal="8dp" android:weightSum="5">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/bg_circle_action" android:src="@drawable/ic_tcx_action_call_outline_24dp" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call" android:textColor="@color/textPrimary" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/bg_circle_wa" android:src="@drawable/ic_tcx_action_whatsapp_outline_24dp" app:tint="#FF25D366"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp" android:textColor="@color/textPrimary" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/bg_circle_action" android:src="@drawable/ic_tcx_card_insights" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pay" android:textColor="@color/textPrimary" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/bg_circle_action" android:src="@drawable/ic_tcx_action_edit_24dp" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textColor="@color/textPrimary" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/bg_circle_action" android:src="@drawable/ic_tcx_block_assistant_24dp" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Block" android:textColor="@color/textPrimary" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== details placeholder (loading skeleton) ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/bg_detail_card" android:layout_marginHorizontal="16dp" android:padding="16dp">
        <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/bg_shimmer"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp" android:gravity="center_vertical">
            <View android:layout_width="56dp" android:layout_height="40dp" android:background="@drawable/bg_shimmer"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                <View android:layout_width="match_parent" android:layout_height="12dp" android:background="@drawable/bg_shimmer"/>
                <View android:layout_width="140dp" android:layout_height="12dp" android:background="@drawable/bg_shimmer" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <View android:layout_width="90dp" android:layout_height="34dp" android:background="@drawable/bg_shimmer" android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== phone number ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="16dp" android:layout_marginTop="8dp">
        <FrameLayout android:layout_width="30dp" android:layout_height="30dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_tcx_action_call_outline_24dp" app:tint="@color/textSecondary"/>
            <TextView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="top|end" android:gravity="center" android:text="1" android:textColor="#FFFFFFFF" android:textSize="9sp" android:background="@drawable/bg_blue_count"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0791 908395" android:textColor="@color/textPrimary" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mobile · Safaricom" android:textColor="@color/textSecondary" android:textSize="14sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="18dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_tcx_action_call_outline_24dp" app:tint="@color/textSecondary"/>
            <TextView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="top|end" android:gravity="center" android:text="2" android:textColor="#FFFFFFFF" android:textSize="9sp" android:background="@drawable/bg_green_count"/>
        </FrameLayout>
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_msg_bubble" app:tint="@color/textSecondary"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF"/>

    <!-- ===== more info ===== -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="16dp">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_location_pin" app:tint="@color/textSecondary"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More info available" android:textColor="@color/textPrimary" android:textSize="18sp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_premium_crown" app:tint="#FFEBA000" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upgrade to Premium to view" android:textColor="@color/textSecondary" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</ScrollView>