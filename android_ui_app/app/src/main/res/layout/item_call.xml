<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingHorizontal="18dp" android:paddingVertical="14dp">

    <!-- avatar (48dp) + optional 't' badge -->
    <FrameLayout android:id="@+id/avatarWrap"
        android:layout_width="52dp" android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:background="@drawable/bg_circle_avatar" android:gravity="center"
            android:textColor="@color/avatarTealText" android:textSize="19sp" android:fontFamily="@font/roboto_medium" />
        <TextView android:id="@+id/tbadge" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_gravity="top|start" android:background="@drawable/bg_t_badge" android:gravity="center"
            android:text="t" android:textColor="@color/white" android:textSize="11sp"
            android:fontFamily="@font/roboto_medium" android:visibility="gone" />
    </FrameLayout>

    <!-- name + optional 'true' badge -->
    <LinearLayout android:id="@+id/nameRow"
        android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/avatarWrap" app:layout_constraintEnd_toStartOf="@id/action"
        app:layout_constraintTop_toTopOf="@id/avatarWrap" app:layout_constraintBottom_toTopOf="@id/subRow"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="17sp"
            android:textColor="@color/textPrimary" android:fontFamily="@font/roboto_medium" />
        <TextView android:id="@+id/trueBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@drawable/bg_true_badge"
            android:paddingHorizontal="8dp" android:paddingVertical="1dp" android:text="true"
            android:textColor="@color/trueBlue" android:textSize="11sp" android:visibility="gone" />
    </LinearLayout>

    <!-- subtitle: direction arrow + optional count box + text -->
    <LinearLayout android:id="@+id/subRow"
        android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginStart="16dp" android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/avatarWrap" app:layout_constraintEnd_toStartOf="@id/action"
        app:layout_constraintTop_toBottomOf="@id/nameRow" app:layout_constraintBottom_toBottomOf="@id/avatarWrap">
        <ImageView android:id="@+id/dir" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="16dp" android:gravity="center" android:background="@drawable/bg_count_box"
            android:paddingHorizontal="4dp" android:layout_marginEnd="6dp"
            android:textColor="@color/textSecondary" android:textSize="11sp" android:visibility="gone" />
        <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/textSecondary" />
    </LinearLayout>

    <!-- right action icon (call / whatsapp) -->
    <ImageView android:id="@+id/action"
        android:layout_width="26dp" android:layout_height="26dp"
        app:tint="@color/iconGray"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
