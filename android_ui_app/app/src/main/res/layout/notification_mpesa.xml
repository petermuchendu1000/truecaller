<?xml version="1.0" encoding="utf-8"?>
<!-- Truecaller-style M-PESA SMS notification body (DecoratedCustomViewStyle).
     CLEAN SLATE: all icons removed (M-PESA logo + AI-summary sparkle). Icons will be added back one
     at a time. Background is solid black. Only text remains:

         UH… received Ksh… from … 0713***703.
         AI summary
         Mark as read
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/ntf_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#8A8D91"
        android:textSize="12sp"
        android:text="AI summary" />

    <TextView
        android:id="@+id/ntf_mark_read"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#146FF5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Mark as read" />
</LinearLayout>
