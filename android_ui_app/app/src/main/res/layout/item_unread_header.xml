<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_unread_header" android:layout_margin="12dp" android:padding="16dp">
    <TextView android:id="@+id/unreadHeaderText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="3 unread messages" android:textColor="@color/m_text_primary" android:textSize="15sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Mark all as read" android:textColor="@color/m_link_blue" android:textSize="15sp" android:fontFamily="@font/roboto_medium"/>
</LinearLayout>