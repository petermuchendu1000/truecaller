<?xml version="1.0" encoding="utf-8"?>
<!-- Truecaller-style M-PESA SMS notification body (DecoratedCustomViewStyle), laid out to match the
     reference pixel-for-pixel. All measurements below were taken from the reference screenshot on a
     411dp-wide device (screenshot scale ~= 1.365 px/dp, calibrated from the 379dp notification
     content width). The system still draws the header text row ("Truecaller · SMS from MPESA · now")
     and the expander; this custom view supplies the icons + body so the icons land exactly where the
     reference shows them.

     The system draws the single header row itself (small icon + "Truecaller · SMS from MPESA · time"
     + expander). This custom view supplies ONLY the body (no duplicate header row):
       Body:  [M-PESA logo 33dp]  UH… received Ksh… from … 0713***703.
                                  ✦ AI summary
              Mark as read

     Measured spec:
       • Truecaller message icon (@mipmap/ic_notif_circle) = 26dp, at content-left (marginStart 0),
         top-aligned with the header text (gravity=top). Header text starts 12dp right of the icon.
       • M-PESA logo (@mipmap/av_mpesa_circle) = 33dp, at content-left (marginStart 0), top-aligned
         with the first summary line (gravity=top). Message text column starts 17dp right of the logo.
       • AI-summary sparkle (@drawable/ic_sparkle_gold) = 12dp, at the text-column left edge, 6dp gap
         to the "AI summary" label.
       • "Mark as read" is left-aligned at the content-left edge (marginStart 0), NOT indented.
     Text colours stay theme-aware (?android:attr/textColor*) for light/dark shades. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Body row: circular white-bg M-PESA logo + the complete SMS body (ntf_summary = m.fullBody). -->
         M-Pesa logo is at the content-left edge (marginStart 0), which aligns vertically with where
         "Truecaller" begins in the system header row (measured: both at the same x). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/ntf_logo"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginStart="0dp"
            android:src="@mipmap/av_mpesa_circle"
            android:contentDescription="M-PESA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="17dp">

            <TextView
                android:id="@+id/ntf_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="20"
                android:autoLink="web"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Open link" outlined button — opens the first URL in the SMS. Measured from the reference:
         thin blue outline, transparent fill, light centred text, rounded corners. Hidden when the
         SMS has no URL. Content-left aligned. -->
    <TextView
        android:id="@+id/ntf_open_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_outlined_button"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:gravity="center"
        android:text="Open link" />

    <!-- Action row: "Mark as read"  |  "Delete" (both blue, content-left; ~32dp gap). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/ntf_mark_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/trueBlue"
            android:textSize="14sp"
            android:text="Mark as read" />

        <TextView
            android:id="@+id/ntf_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textColor="@color/trueBlue"
            android:textSize="14sp"
            android:text="Delete" />
    </LinearLayout>
</LinearLayout>
