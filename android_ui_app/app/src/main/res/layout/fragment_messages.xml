<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/m_bg">

    <!-- Search bar -->
    <LinearLayout android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_msg_search" android:layout_margin="12dp"
        android:paddingStart="6dp" android:paddingEnd="10dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
            <View android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_contacts_circle"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_tcx_contacts_24dp" app:tint="#FFFFFFFF"/>
            <TextView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="top|end"
                android:gravity="center" android:text="2" android:textSize="10sp" android:textColor="#FFFFFFFF"
                android:fontFamily="@font/roboto_medium" android:background="@drawable/bg_white_badge"
                android:textColorHint="#FF000000"/>
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Search numbers, names &amp; more" android:textColor="@color/m_text_secondary"
            android:textSize="15sp" android:layout_marginStart="12dp"/>
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_tcx_more_vert_24dp" app:tint="@color/m_text_secondary"/>
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end"
                android:layout_marginTop="2dp" android:background="@drawable/bg_red_badge"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/searchBar" android:scrollbars="none" android:paddingStart="12dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical"
                android:background="@drawable/bg_chip_selected" android:paddingHorizontal="16dp" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_tcx_messages_24dp" app:tint="#FFFFFFFF" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inbox" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="@font/roboto_medium"/>
                <TextView android:layout_width="20dp" android:layout_height="20dp" android:gravity="center" android:text="2" android:textColor="@color/m_brand_blue" android:textSize="11sp" android:fontFamily="@font/roboto_medium" android:background="@drawable/bg_white_badge" android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical"
                android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="16dp" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_flag_tcx" app:tint="@color/m_brand_blue" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unread" android:textColor="@color/m_text_primary" android:textSize="14sp" android:fontFamily="@font/roboto_medium"/>
                <TextView android:layout_width="20dp" android:layout_height="20dp" android:gravity="center" android:text="2" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="@font/roboto_medium" android:background="@drawable/bg_red_badge" android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical"
                android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="16dp" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_filter_transaction" app:tint="@color/m_brand_blue" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transactions" android:textColor="@color/m_text_primary" android:textSize="14sp" android:fontFamily="@font/roboto_medium"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sticky bottom ad -->
    <LinearLayout android:id="@+id/bottomAd" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/m_bg" android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get 50% Cashback" android:textColor="@color/m_text_primary" android:textSize="16sp" android:fontFamily="@font/roboto_medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Airtel Kenya · Open the app and claim your 50% cashback today." android:maxLines="2" android:ellipsize="end" android:textColor="@color/m_text_secondary" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="@font/roboto_medium" android:paddingHorizontal="18dp" android:paddingVertical="7dp" android:background="@drawable/bg_compose_fab"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/chips" android:layout_above="@id/bottomAd" android:clipToPadding="false" android:paddingBottom="8dp"/>

    <!-- Compose FAB -->
    <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_above="@id/bottomAd" android:layout_alignParentEnd="true" android:layout_margin="14dp" android:background="@drawable/bg_compose_fab">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_tcx_new_message_variant_24dp" app:tint="#FFFFFFFF"/>
    </FrameLayout>
</RelativeLayout>
