<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the latest Truecaller message icon (blue circle + black speech bubble
     + tail + 3 blue dots), rendered as a monochrome glyph for the system to tint. The SYSTEM draws
     the accent circle (setColor = Truecaller blue) around this glyph, so the rendered top-row icon
     is a blue circle with a black speech bubble + dots — matching the latest committed icon
     (0bac1675). Small icons must be monochrome, so this is the single-colour equivalent. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- black speech bubble (filled) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 C6.48,2 2,6.48 2,12 C2,13.5 2.3,14.9 2.8,16.2 L2,22 L7.8,21.2 C9.1,21.7 10.5,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z"/>
    <!-- tail (lower-left) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,16 L4,20 L6,14 Z"/>
    <!-- 3 dots (knocked out = transparent) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M8,12 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 M12,12 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 M16,12 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"/>
</vector>
